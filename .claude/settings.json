{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/tests-must-pass.sh", "timeout": 120 }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm test)", "Bash(npm test:*)", "Bash(npm run serve)", "Bash(node:*)",
      "Bash(git:*)", "Bash(gh issue:*)", "Bash(gh label:*)", "Bash(gh pr:*)", "Bash(gh repo view:*)",
      "Bash(scripts/shot.sh:*)", "Bash(./scripts/shot.sh:*)",
      "Bash(ls:*)", "Bash(cat:*)", "Bash(cd:*)", "Bash(pwd)", "Bash(mkdir:*)",
      "Read(/.claude/worktrees/**)", "Edit(/.claude/worktrees/**)", "Write(/.claude/worktrees/**)"
    ]
  }
}
